{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site.schema.json",
  "title": "Classmaid site config",
  "description": "Global public links and text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["links", "meta"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "links": {
      "type": "object",
      "description": "Public links keyed by name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://\\S+$"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "description": "Text values keyed by name.",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
