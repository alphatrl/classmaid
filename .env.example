SMU_SCRAPER_URL=
SCHOOL_SEMESTERS_URL=
SMU_LIBRARIES_OCCUPANCY_URL=
SMU_LIBRARIES_OCCUPANCY_API_KEY=

# Google service account email used to read the private guides spreadsheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Base64 of the PEM private key: `base64 -i key.pem`, or from the JSON key: `jq -r .private_key key.json | base64`
GOOGLE_PRIVATE_KEY=
# Guides spreadsheet ID (the part of the sheet URL between /d/ and /edit)
SHEET_ID_GUIDES=
# Shared secret for POST /api/content/revalidate (clears the guides cache)
CONTENT_REVALIDATE_SECRET=
